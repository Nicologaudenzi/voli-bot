# Copia questo file in ".env" per provare il bot sul tuo PC.
# Su GitHub queste chiavi vanno in Settings → Secrets and variables → Actions.
# NON caricare mai il file .env su GitHub.

TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=
# Solo per prove locali: tuonome/voli-bot
GITHUB_REPOSITORY=
# 1 = stampa a schermo invece di inviare/pubblicare
DRY_RUN=1
